{
  "name": "bookbookbook-desktop",
  "version": "1.0.8",
  "private": true,
  "description": "Local desktop wrapper for Bookbookbook.",
  "main": "main.cjs",
  "scripts": {
    "build:renderer": "npm --prefix ../pages run build",
    "build:icon": "node scripts/make-icon.mjs",
    "build:dmg-background": "node scripts/make-dmg-background.mjs",
    "set:dmg-icon": "node scripts/set-dmg-icon.mjs",
    "preflight:mas": "node scripts/check-mas-prereqs.mjs",
    "pack": "npm run build:renderer && npm run build:icon && npm run build:dmg-background && electron-builder --mac dir",
    "dist": "npm run build:renderer && npm run build:icon && npm run build:dmg-background && electron-builder --mac dmg && npm run set:dmg-icon",
    "dist:mas": "npm run preflight:mas && npm run build:renderer && npm run build:icon && electron-builder --mac mas --publish never",
    "dist:win": "npm run build:renderer && electron-builder --win nsis --x64 --publish never",
    "smoke": "npm run build:renderer && node tests/smoke.mjs",
    "start": "npm run build:renderer && electron ."
  },
  "author": "hyun2xyz",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.60.0"
  },
  "build": {
    "appId": "xyz.hyun2.bookbookbook",
    "productName": "Bookbookbook",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      {
        "from": "../pages/dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "mas": {
      "category": "public.app-category.productivity",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "identity": "Apple Distribution",
      "provisioningProfile": "build/Bookbookbook_Mac_App_Store.provisionprofile",
      "target": [
        "mas"
      ]
    },
    "afterPack": "scripts/after-pack.cjs",
    "dmg": {
      "artifactName": "Bookbookbook-${version}.dmg",
      "background": "build/dmg-background.png",
      "iconSize": 96,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 170,
          "y": 215,
          "type": "file"
        },
        {
          "x": 370,
          "y": 215,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
